#!/usr/bin/env python3
"""Fake `gh` for intake tests: answers `gh run list -R <owner/name> ...`.

$FAKE_GH_RUNS is a JSON file {"<owner/name>": [run, ...] | {"__fail": "msg"}}.
Only runs with createdAt >= the `--created >=<ts>` bound are returned (like gh).
$FAKE_GH_LOG gets one line per call: "<repo> <created filter>".
Anything that is not `run list` exits 1 so a test notices an unexpected call.
"""
import json, os, sys

args = sys.argv[1:]
if args[:2] != ["run", "list"]:
    sys.stderr.write(f"fake gh: unexpected call {args}\n")
    sys.exit(1)
repo = args[args.index("-R") + 1]
created = args[args.index("--created") + 1] if "--created" in args else ""
if "--status" not in args or args[args.index("--status") + 1] != "failure":
    sys.stderr.write("fake gh: intake must filter --status failure\n")
    sys.exit(1)
if os.environ.get("FAKE_GH_LOG"):
    with open(os.environ["FAKE_GH_LOG"], "a") as fh:
        fh.write(f"{repo} {created}\n")
with open(os.environ["FAKE_GH_RUNS"]) as fh:
    routes = json.load(fh)
r = routes.get(repo)
if r is None:
    sys.stderr.write(f"HTTP 404: Not Found (https://api.github.com/repos/{repo}/actions/runs)\n")
    sys.exit(1)
if isinstance(r, dict) and "__fail" in r:
    sys.stderr.write(r["__fail"] + "\n")
    sys.exit(1)
bound = created[2:] if created.startswith(">=") else ""
print(json.dumps([x for x in r if not bound or x["createdAt"] >= bound]))
